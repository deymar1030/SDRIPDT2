# --- Base de datos: elige UNA de las dos formas ---
# a) Desarrollo local rápido con SQLite:
DATABASE_URL=sqlite:///./app.db
# b) PostgreSQL por partes (la contraseña puede tener cualquier carácter):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=simulador
# POSTGRES_PASSWORD=
# POSTGRES_DB=simulador

# Obligatoria, mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Solo hace falta si el frontend se sirve desde otro origen (en desarrollo, Vite usa proxy).
CORS_ORIGINS=
